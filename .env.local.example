# Apple Developer Code Signing
# Thay thế các giá trị sau bằng thông tin của bạn

# Tên hoặc ID của certificate (lấy từ: security find-identity -v -p codesigning)
# VD: "Developer ID Application: Your Name (TEAM_ID)"
CSC_NAME="Developer ID Application: Your Name (TEAM_ID)"

# Hoặc dùng certificate file .p12 (nếu export từ Keychain)
# CSC_LINK=/path/to/certificate.p12
# CSC_KEY_PASSWORD=your_certificate_password

# Apple ID để notarize (tùy chọn nhưng khuyên dùng)
APPLE_ID=your@apple.id
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=YOUR_TEAM_ID

# Build settings
# Set to false if you don't want to notarize
NOTARIZE=true
